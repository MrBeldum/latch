[Unit]
Description=Latch native streaming engine
Requires=latch-desktop.service
After=latch-desktop.service pulseaudio.service
Wants=pulseaudio.service

[Service]
Environment=DISPLAY=:1
Environment=XAUTHORITY=%t/latch.Xauthority
WorkingDirectory=%h/.config/sunshine
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/sunshine %h/.config/sunshine/sunshine.conf
# The encoder runs on the CPU. When other user services (an agent, a build)
# want every core too, frames that miss their interval are dropped: give the
# engine ten times their share. It cannot raise its own priority as a user.
CPUWeight=1000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
