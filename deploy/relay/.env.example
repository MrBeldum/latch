# Copy to .env, then fill in. `.env` is gitignored — never commit it, never paste a
# key into a shell that has tracing on.
#
#   cp .env.example .env && chmod 600 .env

# Auth key from https://login.tailscale.com/admin/settings/keys
#   Reusable:  yes   (so a rebuild does not need a new key)
#   Ephemeral: NO    (an ephemeral relay disappears from the tailnet when it restarts)
#   Tags:      tag:relay
# An OAuth client secret works too; it still needs the tag in TS_EXTRA_ARGS below.
TS_AUTHKEY=

# Tailnet node name for this relay.
TS_HOSTNAME=relay

# The tag must match the ACL grant in RELAY.md and the tag on the auth key.
TS_EXTRA_ARGS=--advertise-tags=tag:relay

# UDP port the relay listens on. Must be open in the host firewall AND in the cloud
# provider's security list. install-relay.sh opens the host side.
RELAY_PORT=40000

# Optional. Comma-separated ip:port (IPv6 as [addr]:port) to advertise on top of the
# addresses Tailscale discovers. Leave empty: the entrypoint resolves the public IPv4
# at start, which is what you want when the instance has no reserved address. Set this
# only for port forwarding, a load balancer, or to advertise an extra IPv6 endpoint.
RELAY_STATIC_ENDPOINTS=

# How long the entrypoint waits for the node to authenticate before giving up on
# applying relay prefs. Bump it if you log in by hand from the container logs.
RELAY_WAIT_SECS=180

# Pin the image if you want reproducible deploys; a pin is updated only by bumping
# it, while install-relay.sh pulls latest on every run. Peer relay needs 1.86 or later.
# TS_IMAGE=tailscale/tailscale:latest
